<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_DesarrolloSW" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Generador académico" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Proc_DesarrolloSW"><bpmn:participant id="Pool_Proc_DesarrolloSW" name="SoftHealth S.A.C. – Desarrollo del producto SIH-HRI (Scrum + DevOps)" processRef="Proc_DesarrolloSW"/></bpmn:collaboration>
  <bpmn:process id="Proc_DesarrolloSW" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_cli" name="Cliente / PO">
        <bpmn:flowNodeRef>c0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sm" name="Scrum Master / JP">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_dev" name="Equipo de desarrollo">
        <bpmn:flowNodeRef>d1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_qa" name="QA / Calidad">
        <bpmn:flowNodeRef>q1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ops" name="DevOps">
        <bpmn:flowNodeRef>o1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c0" name="Necesidad del hospital"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="c1" name="Levantar requerimientos (historias de usuario)"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="c2" name="Priorizar Product Backlog"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="s1" name="Sprint Planning (meta y Sprint Backlog)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="d1" name="Diseñar solución (UML / arquitectura)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="d2" name="Codificar + pruebas unitarias"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="¿Code review aprobado?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="o1" name="Integración continua (build + tests automáticos)"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="q1" name="Pruebas funcionales y de integración"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="¿Defectos críticos?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="c3" name="Sprint Review: demo del incremento"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="¿Incremento aceptado?"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="o2" name="Desplegar en producción (CD)"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="s2" name="Retrospectiva y acciones de mejora"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g5" name="¿Backlog pendiente?"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e" name="Producto entregado"><bpmn:incoming>Flow_19</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="c0" targetRef="c1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="c1" targetRef="c2"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="c2" targetRef="s1"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="s1" targetRef="d1"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="d1" targetRef="d2"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="d2" targetRef="g1"/>
    <bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="g1" targetRef="d2"/>
    <bpmn:sequenceFlow id="Flow_8" name="Sí" sourceRef="g1" targetRef="o1"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="o1" targetRef="q1"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="q1" targetRef="g3"/>
    <bpmn:sequenceFlow id="Flow_11" name="Sí: corregir" sourceRef="g3" targetRef="d2"/>
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="g3" targetRef="c3"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="c3" targetRef="g4"/>
    <bpmn:sequenceFlow id="Flow_14" name="No: ajustar" sourceRef="g4" targetRef="c2"/>
    <bpmn:sequenceFlow id="Flow_15" name="Sí" sourceRef="g4" targetRef="o2"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="o2" targetRef="s2"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="s2" targetRef="g5"/>
    <bpmn:sequenceFlow id="Flow_18" name="Sí: nuevo sprint" sourceRef="g5" targetRef="s1"/>
    <bpmn:sequenceFlow id="Flow_19" name="No" sourceRef="g5" targetRef="e"/>
  </bpmn:process>
