<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proc_AtencionTOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Generador académico" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Proc_AtencionTOBE"><bpmn:participant id="Pool_Proc_AtencionTOBE" name="Hospital Regional Inteligente – Atención integrada del paciente (TO-BE)" processRef="Proc_AtencionTOBE"/></bpmn:collaboration>
  <bpmn:process id="Proc_AtencionTOBE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_pac" name="Paciente">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_plat" name="Plataforma integrada">
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_adm" name="Admisión">
        <bpmn:flowNodeRef>r1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_med" name="Médico">
        <bpmn:flowNodeRef>m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_lab" name="Laboratorio">
        <bpmn:flowNodeRef>l1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_far" name="Farmacia">
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_fac" name="Facturación">
        <bpmn:flowNodeRef>k1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Requiere atención"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="p1" name="Solicitar cita (web, app o ventanilla)"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="a1" name="Validar identidad en índice maestro (MPI)"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="¿Paciente registrado?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="r1" name="Registrar paciente una única vez"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name=""><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="a2" name="Asignar cita y notificar (SMS / app)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:dataOutputAssociation id="Assoc_1"><bpmn:targetRef>db</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:userTask id="p2" name="Check-in con QR o DNI"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="m1" name="Atender consulta y registrar en HCE"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:dataOutputAssociation id="Assoc_2"><bpmn:targetRef>db</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
    <bpmn:inclusiveGateway id="g3" name="¿Qué órdenes emite?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:userTask id="l1" name="Tomar y procesar muestra"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="l2" name="Validar, publicar en HCE y notificar"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:dataOutputAssociation id="Assoc_3"><bpmn:targetRef>db</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:serviceTask id="f1" name="Verificar stock y reservar (SCM)"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="f2" name="Dispensar receta electrónica"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:userTask>
    <bpmn:inclusiveGateway id="g4" name=""><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:serviceTask id="k1" name="Consolidar cargos y emitir factura electrónica (ERP)"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="p3" name="Pagar y recibir comprobante digital"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e" name="Atención completada"><bpmn:incoming>Flow_20</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataStoreReference id="db" name="BD única: MPI + HCE + ERP"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="p1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="p1" targetRef="a1"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="a1" targetRef="g1"/>
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="g1" targetRef="r1"/>
    <bpmn:sequenceFlow id="Flow_5" name="Sí" sourceRef="g1" targetRef="g2"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="r1" targetRef="g2"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="g2" targetRef="a2"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="a2" targetRef="p2"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="p2" targetRef="m1"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="m1" targetRef="g3"/>
    <bpmn:sequenceFlow id="Flow_11" name="Análisis" sourceRef="g3" targetRef="l1"/>
    <bpmn:sequenceFlow id="Flow_12" name="Receta" sourceRef="g3" targetRef="f1"/>
    <bpmn:sequenceFlow id="Flow_13" name="Solo consulta" sourceRef="g3" targetRef="g4"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="l1" targetRef="l2"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="f1" targetRef="f2"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="l2" targetRef="g4"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="f2" targetRef="g4"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="g4" targetRef="k1"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="k1" targetRef="p3"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="p3" targetRef="e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_Proc_AtencionTOBE"><bpmndi:BPMNPlane id="Plane_Proc_AtencionTOBE" bpmnElement="Collab_Proc_AtencionTOBE">
    <bpmndi:BPMNShape id="Pool_Proc_AtencionTOBE_di" bpmnElement="Pool_Proc_AtencionTOBE" isHorizontal="true"><dc:Bounds x="20" y="20" width="2274" height="980"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_pac_di" bpmnElement="Lane_pac" isHorizontal="true"><dc:Bounds x="50" y="20" width="2244" height="140"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_plat_di" bpmnElement="Lane_plat" isHorizontal="true"><dc:Bounds x="50" y="160" width="2244" height="140"/></bpmndi:BPMNShape>
